# ─── Login ───────────────────────────────────────────────────────────────
# "qr" (scan a QR code) or "pairing" (enter a code on your phone)
AUTH_METHOD=qr

# Required only when AUTH_METHOD=pairing. Digits only, with country code.
# Example: 923001234567
BOT_NUMBER=

# ─── Identity ────────────────────────────────────────────────────────────
BOT_NAME=Cosmic WA Bot
OWNER_NAME=
# Owner phone number(s), digits only, comma-separated. REQUIRED for
# !plugin / !feature / !vcf. Example: 923001234567
OWNER_NUMBER=
# Legacy alias (JIDs or numbers also accepted):
# OWNERS=923001234567@s.whatsapp.net

# Command prefix
PREFIX=!

# ─── Paths ───────────────────────────────────────────────────────────────
AUTH_DIR=auth
PLUGINS_DIR=plugins
# Runtime plugin on/off state (git-ignored)
STATE_FILE=data/state.json

# ─── Behaviour ───────────────────────────────────────────────────────────
HOT_RELOAD=true
LOG_LEVEL=info
# Auto-view statuses (listener). Optional reaction: AUTO_STATUS_REACT=true
# AUTO_STATUS_REACT=false
# Show typing/recording presence in DMs: AUTO_TYPING=true
# AUTO_TYPING=false
# AUTO_TYPING_GROUPS=false

# ─── Web server (keep-alive / health / optional QR+pair) ─────────────────
WEB_SERVER=true
PORT=3000
# If set, unlocks GET /qr?token=… and GET /pair?token=…&phone=…
WEB_TOKEN=

# ─── Third-party APIs (features disable cleanly when unset) ──────────────
GROQ_API_KEY=
# Optional override of the default Groq model id
# GROQ_MODEL=llama-3.1-8b-instant
OPENWEATHER_API_KEY=

# Outbound HTTP timeout for weather / groq / pollai (ms)
HTTP_TIMEOUT_MS=20000
