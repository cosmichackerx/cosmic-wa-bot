# Login method: "qr" (scan a QR code) or "pairing" (enter a code on your phone)
AUTH_METHOD=qr

# Required only when AUTH_METHOD=pairing. Full number incl. country code, digits only.
# Example: 923001234567 (no +, no spaces)
BOT_NUMBER=

# Command prefix that triggers plugins
PREFIX=!

# Folder where credentials are stored (git-ignored)
AUTH_DIR=auth

# Folder that holds plug-and-play plugins
PLUGINS_DIR=plugins

# Hot-reload plugins when files are added/changed (true|false)
HOT_RELOAD=true

# Log level: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# Optional: comma-separated JIDs allowed to use the bot (empty = everyone)
# Example: 923001234567@s.whatsapp.net
OWNERS=
