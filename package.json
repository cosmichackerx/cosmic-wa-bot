  "repository": {
    "type": "git",
    "url": "https://github.com/cosmichackerx/cosmic-wa-bot.git"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "6.7.24",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pino": "^9.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
